{
  "name": "cusol-uis-disasters-platform-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "expo-router/entry",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "start": "expo start",
    "dev": "expo start --web --port 3100 --host lan",
    "web": "expo start --web --port 3100",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "build": "expo export --platform web --clear",
    "lint": "eslint .",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "typecheck": "tsc --noEmit --pretty false"
  },
  "dependencies": {
    "@expo/metro-runtime": "~56.0.19",
    "@googlemaps/js-api-loader": "^2.1.1",
    "expo": "~56.0.19",
    "expo-constants": "~56.0.23",
    "expo-document-picker": "~56.0.4",
    "expo-linear-gradient": "~56.0.4",
    "expo-linking": "~56.0.16",
    "expo-router": "~56.2.18",
    "expo-status-bar": "~56.0.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-maps": "1.27.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/react-native": "13.3.3",
    "@types/google.maps": "^3.65.5",
    "@types/jest": "29.5.14",
    "@types/node": "20.19.43",
    "@types/react": "~19.2.2",
    "eslint": "10.8.1",
    "globals": "17.11.0",
    "jest": "~29.7.0",
    "jest-expo": "~56.0.5",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.67.0"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/src/test/setup.ts"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/src/app/"
    ]
  }
}

EXPO_PUBLIC_DASHBOARD_DATA_MODE=api
# Usa `demo` únicamente para trabajar sin backend con el fixture local.
# Navegador: http://localhost:8000
# Emulador Android: http://10.0.2.2:8000
# Dispositivo físico: http://IP_LOCAL_DEL_COMPUTADOR:8000
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000

# CHG-036: usa `demo` hasta que Claude entregue los endpoints /api/v1/admin.
# La sesión y la autorización de la ruta siempre se validan contra la API real.
EXPO_PUBLIC_ADMIN_DATA_MODE=demo
# Solo para el proxy web de Metro. En Compose ya apunta al gateway interno.
EXPO_API_PROXY_TARGET=http://localhost:8000

# CHG-006 está disponible en backend. Usa `demo` solo para trabajar sin API.
EXPO_PUBLIC_OPERATIONAL_MAP_DATA_MODE=api

# CHG-015: clusters geográficos de situación humana. Usa `demo` solo sin backend.
EXPO_PUBLIC_HUMAN_MAP_DATA_MODE=api

# CHG-018: listado paginado de todas las personas publicables.
EXPO_PUBLIC_PEOPLE_RECORDS_DATA_MODE=api

# CHG-007/T016: búsqueda y envío de reportes usan la API real. Usa `demo` solo sin backend.
EXPO_PUBLIC_MISSING_PERSON_DATA_MODE=api

# CHG-034: directorio unificado y aportes con evidencia. Usa `demo` mientras
# Claude implementa T007-T009; cambia a `api` para la integración real.
EXPO_PUBLIC_HUMANITARIAN_DIRECTORY_DATA_MODE=api
EXPO_PUBLIC_COMMUNITY_CONTRIBUTION_DATA_MODE=api

# CHG-035: el reporte de edificio usa siempre la API real. En web puede usar el
# proxy del mismo origen; en móvil toma EXPO_PUBLIC_API_BASE_URL. No tiene modo demo.

# Google Maps web. La clave se publica en el bundle y debe restringirse por referente HTTP.
EXPO_PUBLIC_GOOGLE_MAPS_WEB_API_KEY=
EXPO_PUBLIC_GOOGLE_MAPS_MAP_ID=DEMO_MAP_ID

# Android/iOS. Activa el mapa nativo solo en builds que tengan sus claves configuradas.
EXPO_PUBLIC_GOOGLE_MAPS_NATIVE_ENABLED=false
GOOGLE_MAPS_ANDROID_API_KEY=
GOOGLE_MAPS_IOS_API_KEY=

# CHG-008: OpenStreetMap es el respaldo real sin clave.
# Úsalo en `true` para probar la degradación final sin teselas/conectividad.
EXPO_PUBLIC_OSM_TILES_DISABLED=false

# CHG-165: comentarios y denuncias de Centros de Acopio Local.
# "demo" usa datos sintéticos sin red (jest lo fija automáticamente).
EXPO_PUBLIC_AID_LOCATION_COMMUNITY_DATA_MODE=

{
  "expo": {
    "name": "CUSOL Desastres Colombia",
    "slug": "cusol-disasters-colombia",
    "scheme": "cusoldisasters",
    "version": "0.1.0",
    "orientation": "default",
    "userInterfaceStyle": "dark",
    "icon": "./src/assets/app-icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "co.edu.uis.cusol.disasters"
    },
    "android": {
      "package": "co.edu.uis.cusol.disasters",
      "predictiveBackGestureEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/app-icon-foreground.png",
        "backgroundColor": "#050710"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "CUSOL Desastres comparte tu ubicación mientras la app está en uso para coordinar la respuesta a emergencias."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
